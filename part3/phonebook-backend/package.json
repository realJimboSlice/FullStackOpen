{
  "name": "phonebook-backend",
  "version": "1.0.0",
  "description": "exercise 3.1 to 3.8",
  "license": "ISC",
  "author": "Jimbo Slice",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:frontend": "cd ../phonebook && npm run build",
    "copy:frontend": "shx rm -rf dist && shx cp -r ../phonebook/dist ./dist",
    "build:ui": "npm run build:frontend && npm run copy:frontend",
    "deploy:full": "npm run build:ui && git add . && git commit -m \"uibuild\" && git push"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1",
    "shx": "^0.4.0"
  }
}
